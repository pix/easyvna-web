# Keep LF line endings in every checkout (Windows included): the single-file
# browser build embeds these sources verbatim, and shell scripts need LF.
* text=auto eol=lf
*.go    text eol=lf
*.js    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
*.py    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
LICENSE text eol=lf
*.png   binary
*.jpg   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.wasm  binary
*.exe   binary
